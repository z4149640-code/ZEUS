-- إنشاء أو تحديث جدول المنتجات
CREATE TABLE IF NOT EXISTS public.products (
  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  title TEXT NOT NULL,
  price NUMERIC NOT NULL,
  sizes TEXT[] NOT NULL,
  variants JSONB NOT NULL,
  is_available BOOLEAN DEFAULT TRUE,
  category TEXT,
  description TEXT,
  badge TEXT,
  size_chart_url TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL
);

-- تعطيل حماية الـ RLS مؤقتاً عشان نقدر نضيف ونمسح بيانات من لوحة التحكم براحتنا
-- (مهم جداً لحل مشكلة 401 Unauthorized)
ALTER TABLE public.products DISABLE ROW LEVEL SECURITY;

-- لو الجدول موجود بالفعل، أضف العمود الجديد فقط:
ALTER TABLE public.products ADD COLUMN IF NOT EXISTS size_chart_url TEXT;

-- Volume Discounts: array of { quantity, price } bundle offers per product
-- Example: [{"quantity": 2, "price": 700}]  means "Buy 2 for 700 EGP"
ALTER TABLE public.products ADD COLUMN IF NOT EXISTS offers JSONB DEFAULT '[]'::jsonb;

